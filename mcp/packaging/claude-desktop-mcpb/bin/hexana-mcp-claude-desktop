#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
LAUNCHER="$PLUGIN_ROOT/bin/hexana-mcp"

if [ ! -f "$LAUNCHER" ]; then
  echo "Hexana MCP launcher not found: $LAUNCHER" >&2
  exit 1
fi

if [ ! -x "$LAUNCHER" ]; then
  echo "Hexana MCP launcher is not executable: $LAUNCHER" >&2
  exit 1
fi

if [ "$#" -eq 0 ]; then
  echo "Hexana MCPB requires at least one allowed directory selected in Claude Desktop." >&2
  exit 1
fi

ROOT_COUNT=0
for allowed_root in "$@"; do
  if [ -n "$allowed_root" ]; then
    ROOT_COUNT=$((ROOT_COUNT + 1))
    if [ "$ROOT_COUNT" -eq 1 ]; then
      set -- stdio --allowed-root "$allowed_root"
    else
      set -- "$@" --allowed-root "$allowed_root"
    fi
  fi
done

if [ "$ROOT_COUNT" -eq 0 ]; then
  echo "Hexana MCPB received only empty allowed-directory values from Claude Desktop." >&2
  exit 1
fi

exec "$LAUNCHER" "$@"
