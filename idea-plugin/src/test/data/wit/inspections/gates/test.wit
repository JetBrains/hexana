@since(version = 1.0.0)
interface i1 {
    @since(version = 0.9.0)
    <error descr="Item version 0.9.0 is lower than container version 1.0.0">f1</error>: func();

    @since(version = 1.1.0)
    f2: func();

    <error descr="Item must be gated because its container is gated">f3</error>: func();

    @unstable(feature = f)
    @since(version = 1.2.0)
    <error descr="Both @since and @unstable are used">f4</error>: func();
}

@unstable(feature = f)
interface i2 {
    @since(version = 1.0.0)
    f1: func(); 
}

interface i3 {
    f1: func(); // fine
}

interface i4 {
    @since(version = 1.0.0)
    resource r1 {
        @since(version = 1.1.0)
        m1: func();

        <error descr="Item must be gated because its container is gated">m2</error>: func();

        @since(version = 0.8.0)
        <error descr="Item version 0.8.0 is lower than container version 1.0.0">m3</error>: func();
    }
}
