<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <fileBasedIndex implementation="org.jetbrains.hexana.javaLang.JavaWasmReferenceIndex"/>
        <!-- JIT Viewer agent injection on Java-based run configs. Lives here (Java-gated)
             because RunConfigurationExtension is provided by com.intellij.java, not the base
             platform — registering it in core plugin.xml crashes non-IDEA IDEs at startup. -->
        <runConfigurationExtension implementation="org.jetbrains.hexana.jit.JitviewRunConfigurationExtension"/>
        <completion.contributor language="JAVA"
                                implementationClass="org.jetbrains.hexana.javaLang.GraalWasmJavaCompletionContributor"
                                order="first"/>
        <completion.contributor language="JAVA"
                                implementationClass="org.jetbrains.hexana.javaLang.ChicoryJavaCompletionContributor"
                                order="first"/>
        <localInspection language="JAVA"
                         groupName="WebAssembly"
                         shortName="WasmExportInspection"
                         displayName="Unresolved WebAssembly export name"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.jetbrains.hexana.javaLang.WasmExportInspection"/>
        <localInspection language="JAVA"
                         groupName="WebAssembly"
                         shortName="WasmExportArgCountInspection"
                         displayName="WebAssembly export argument count mismatch"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.jetbrains.hexana.javaLang.WasmExportArgCountInspection"/>
        <localInspection language="JAVA"
                         groupName="WebAssembly"
                         shortName="WasmImportInspection"
                         displayName="Unresolved WebAssembly import name"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.jetbrains.hexana.javaLang.WasmImportInspection"/>
        <localInspection language="JAVA"
                         groupName="WebAssembly"
                         shortName="WasmExportArgTypeInspection"
                         displayName="WebAssembly export argument type mismatch"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.jetbrains.hexana.javaLang.WasmExportArgTypeInspection"/>
    </extensions>
    <!-- Java-PSI-backed implementation of the core SymbolNavigator EP (Graal/Kotlin/JIT-inline
         "go to source/bytecode"). Loads only where com.intellij.modules.java is present. -->
    <extensions defaultExtensionNs="org.jetbrains.hexana">
        <symbolNavigator implementation="org.jetbrains.hexana.javaLang.JavaSymbolNavigator"/>
    </extensions>
</idea-plugin>
