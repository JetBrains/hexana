<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>org.jetbrains.hexana</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Hexana — WebAssembly &amp; Binary Inspector</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://jetbrains.github.io/hexana/">JetBrains</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p>Hexana — an IntelliJ Platform plugin for WebAssembly and binary analysis — opens
        compiled artifacts as structured, navigable documents inside JetBrains IDEs.</p>

        <p><b>Binary formats</b></p>
        <ul>
          <li>Hex editor for any file, with search and go-to-offset</li>
          <li>WASM (<code>.wasm</code>): section browser, imports/exports, function types, code bodies, GC types, WIT (Component Model) interfaces, DWARF 4/5 debug info</li>
          <li>ELF (<code>.elf</code>, <code>.so</code>), Mach-O (<code>.dylib</code>, <code>.bundle</code>), PE (<code>.exe</code>, <code>.dll</code>, <code>.sys</code>) — magic-byte detection</li>
          <li>Multi-architecture disassembly for x86, x86-64, ARM, AArch64, RISC-V 32/64 — bundled as a Rust/WASM module, no host toolchain required, virtualized for multi-MB binaries</li>
          <li>Archive viewer for <code>.jar</code>, <code>.zip</code>, <code>.war</code>, <code>.apk</code></li>
          <li>JVM JIT viewer: a JVMTI agent attaches to any Java run configuration, captures compiled methods into a <code>.jit</code> file, and renders them with a symbol tree and per-method disassembly</li>
        </ul>

        <p><b>Language support</b></p>
        <ul>
          <li>WAT (WebAssembly Text Format): PSI-backed parser, syntax highlighting, brace matching, find-usages, documentation</li>
          <li>WIT (Component Model interface language): inspections, formatting, completion, go-to-definition, indexing</li>
          <li>Java: completion and navigation for GraalWasm and Chicory APIs</li>
          <li>JavaScript / TypeScript: type inference for <code>WebAssembly.instantiate(...)</code> imports and exports, resolved from the referenced <code>.wasm</code> file</li>
        </ul>

        <p>WASM run configurations support line-breakpoint debugging. An MCP server exposes function lists,
        type signatures, data segments, and module structure to AI assistants through the Model Context Protocol.</p>
    ]]></description>

    <resource-bundle>messages.HexanaBundle</resource-bundle>

    <depends optional="true" config-file="org.jetbrains.hexana.javascript.xml">JavaScript</depends>
    <depends optional="true" config-file="org.jetbrains.hexana.java.xml">com.intellij.modules.java</depends>
    <depends optional="true" config-file="org.jetbrains.hexana.maven.xml">org.jetbrains.idea.maven</depends>
    <depends optional="true" config-file="org.jetbrains.hexana.gradle.xml">com.intellij.gradle</depends>

    <dependencies>
        <plugin id="com.intellij.mcpServer"/>
        <module name="intellij.libraries.skiko"/>
        <module name="intellij.libraries.compose.foundation.desktop"/>

        <module name="intellij.platform.compose"/>
        <module name="intellij.platform.jewel.foundation"/>
        <module name="intellij.platform.jewel.ui"/>
        <module name="intellij.platform.jewel.ideLafBridge"/>
    </dependencies>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Disassembly view tunables. Toggle live via
             Help → Find Action → Registry... → search "hexana.disassembly".
             Backend + split changes take effect on the next panel open
             (or via the panel's Retry button). -->
        <registryKey key="hexana.disassembly.backend.redline"
                     defaultValue="false"
                     description="Use chicory-redline (Cranelift-compiled native code via FFI) for the Capstone WASM module instead of Chicory's bytecode AOT. Experimental — see user/capstone-chicory-redline branch."/>
        <registryKey key="hexana.disassembly.perf.logging"
                     defaultValue="false"
                     description="Emit per-chunk [disasm-perf] timing to idea.log (decodeMs, renderMs, annotatedLen). Fires only when a function body is unfolded — the default-folded UX means no perf log until the user opens a function."/>

        <!-- Status bar widget surfacing in-flight Hexana disassembly work.
             Hidden when idle; shows "Disassembling: N" while decode +
             render is happening. -->
        <statusBarWidgetFactory id="Hexana.Disasm.Activity"
                                implementation="org.jetbrains.hexana.ui.panel.DisasmActivityStatusBarWidgetFactory"/>

        <applicationConfigurable parentId="tools"
                                 id="hexana.settings"
                                 bundle="messages.HexanaBundle"
                                 key="hexana.settings.displayName"
                                 provider="org.jetbrains.hexana.HexanaConfigurableProvider"/>

        <applicationConfigurable parentId="build"
                                 id="wasm.runtime.settings"
                                 bundle="messages.HexanaBundle"
                                 key="wasm.runtime.settings.displayName"
                                 instance="org.jetbrains.hexana.run.WasmRuntimeConfigurable"/>

        <applicationService serviceImplementation="org.jetbrains.hexana.run.WasmRuntimeSettings"/>

        <fileType name="wasm"
                  implementationClass="org.jetbrains.hexana.WasmFileType"
                  fieldName="INSTANCE"
                  extensions="wasm" />

        <fileType name="binary"
                  implementationClass="org.jetbrains.hexana.BinaryFileType"
                  fieldName="INSTANCE"
                  extensions="bin"/>

        <fileType name="ELF"
                  implementationClass="org.jetbrains.hexana.ElfFileType"
                  fieldName="INSTANCE"
                  extensions="elf;so"/>

        <fileType name="Mach-O"
                  implementationClass="org.jetbrains.hexana.MachOFileType"
                  fieldName="INSTANCE"
                  extensions="dylib;bundle"/>

        <fileType name="PE"
                  implementationClass="org.jetbrains.hexana.PeFileType"
                  fieldName="INSTANCE"
                  extensions="exe;dll;sys;drv"/>

        <!-- No extensions: `.a`/`.lib` are recognised by the "!<arch>\n" content magic in
             NativeBinaryFileTypeDetector. Binding the extension would beat the detector and
             force this type onto non-archive `.lib` files (MSVC import libraries). -->
        <fileType name="Archive"
                  implementationClass="org.jetbrains.hexana.ArchiveFileType"
                  fieldName="INSTANCE"/>

        <fileType name="wat"
                  implementationClass="org.jetbrains.hexana.wat.WatFileType"
                  fieldName="INSTANCE"
                  language="wat"
                  extensions="wat" />

        <fileType name="wit"
                  implementationClass="org.jetbrains.hexana.wit.WitFileType"
                  fieldName="INSTANCE"
                  language="wit"
                  extensions="wit" />

        <fileType name="jit"
                  implementationClass="org.jetbrains.hexana.JitFileType"
                  fieldName="INSTANCE"
                  extensions="jit"/>

        <fileType name="dex"
                  implementationClass="org.jetbrains.hexana.DexFileType"
                  fieldName="INSTANCE"
                  extensions="dex"/>

        <fileEditorProvider implementation="org.jetbrains.hexana.HexanaFileEditorProvider"/>
        <editorTabTitleProvider implementation="org.jetbrains.hexana.ArchiveMemberTabTitleProvider"/>
        <editorNotificationProvider implementation="org.jetbrains.hexana.wat.MissingWasmToolsNotification"/>
        <fileTypeOverrider implementation="org.jetbrains.hexana.actions.HexFileTypeOverrider"/>
        <fileTypeDetector implementation="org.jetbrains.hexana.NativeBinaryFileTypeDetector"/>
        <statistics.counterUsagesCollector
                implementationClass="org.jetbrains.hexana.statistics.HexanaCounterUsagesCollector"/>
        <useScopeOptimizer implementation="org.jetbrains.hexana.wat.WatScopeOptimizer"/>
        <lang.parserDefinition language="wat" implementationClass="org.jetbrains.hexana.wat.psi.WatParserDefinition" />
        <lang.syntaxHighlighter language="wat" implementationClass="org.jetbrains.hexana.wat.WatSyntaxHighlighter"/>
        <fileEditor.fileSizeChecker implementation="org.jetbrains.hexana.wat.WatFileSizeChecker"/>
        <fileEditor.fileSizeChecker implementation="org.jetbrains.hexana.WasmFileSizeChecker"/>
        <braceMatcher filetype="wat" implementationClass="org.jetbrains.hexana.wat.WatBraceMatcher"/>
        <lang.fileViewProviderFactory language="wat" implementationClass="org.jetbrains.hexana.wat.psi.WatFileViewProviderFactory"/>
        <problemHighlightFilter implementation="org.jetbrains.hexana.wat.WatProblemHighlightFilter"/>
        <platform.backend.documentation.psiTargetProvider implementation="org.jetbrains.hexana.wat.WatDocumentationTargetProvider"/>
        <findUsagesHandlerFactory implementation="org.jetbrains.hexana.wat.WatFindUsagesHandlerFactory"/>

        <!-- actionConfigurationCustomizer implementation="org.jetbrains.hexana.mcp.McpServerCustomizer"/-->
        <actionConfigurationCustomizer implementation="org.jetbrains.hexana.graalvm.GraalInstallationCustomizer"/>
        <mcpServer.mcpToolsProvider implementation="org.jetbrains.hexana.mcp.HexanaToolset"/>
        <notificationGroup id="hexana" displayType="BALLOON" bundle="messages.HexanaBundle" key="notifications.groupKey"/>

        <lang.parserDefinition language="wit" implementationClass="org.jetbrains.hexana.wit.psi.WitParserDefinition" />
        <lang.syntaxHighlighter language="wit" implementationClass="org.jetbrains.hexana.wit.WitSyntaxHighlighter"/>
        <braceMatcher filetype="wit" implementationClass="org.jetbrains.hexana.wit.WitBraceMatcher"/>
        <lang.commenter language="wit" implementationClass="org.jetbrains.hexana.wit.WitCommenter"/>
        <lang.foldingBuilder language="wit" implementationClass="org.jetbrains.hexana.wit.WitFoldingBuilder"/>
        <breadcrumbsInfoProvider implementation="org.jetbrains.hexana.wit.WitBreadcrumbsProvider"/>
        <highlightVisitor implementation="org.jetbrains.hexana.wit.WitSemanticKeywordHighlighter" order="first"/>
        <lang.elementManipulator forClass="org.jetbrains.hexana.wit.psi.WitHandle"
                                 implementationClass="org.jetbrains.hexana.wit.psi.impl.WitHandleManipulator"/>
        <lang.elementManipulator forClass="org.jetbrains.hexana.wit.psi.WitUsePath"
                                 implementationClass="org.jetbrains.hexana.wit.psi.impl.WitUsePathManipulator"/>
        <lang.elementManipulator forClass="org.jetbrains.hexana.wit.psi.WitUseNamesItem"
                                 implementationClass="org.jetbrains.hexana.wit.psi.impl.WitUseNamesItemManipulator"/>
        <lang.elementManipulator forClass="org.jetbrains.hexana.wit.psi.WitIncludeNamesItem"
                                 implementationClass="org.jetbrains.hexana.wit.psi.impl.WitIncludeNamesItemManipulator"/>
        <renameInputValidator implementation="org.jetbrains.hexana.wit.psi.WitRenameInputValidator" />
        <fileBasedIndex implementation="org.jetbrains.hexana.wit.WitComponentIndex"/>
        <fileBasedIndex implementation="org.jetbrains.hexana.WasmIndex"/>
        <fileBasedIndex implementation="org.jetbrains.hexana.WasmExportIndex"/>
        <fileBasedIndex implementation="org.jetbrains.hexana.DwarfIndex"/>
        <gotoSymbolContributor implementation="org.jetbrains.hexana.navigation.HexanaGotoSymbolContributor"/>
        <platform.backend.documentation.psiTargetProvider implementation="org.jetbrains.hexana.wit.WitDocumentationProvider"/>
        <findUsagesHandlerFactory id="wit" implementation="org.jetbrains.hexana.wit.WitFindUsagesHandlerFactory"/>
        <indexedRootsProvider implementation="org.jetbrains.hexana.wit.WitBuiltInDefinitionsContributor"/>
        <codeInsight.lineMarkerProvider language="wit" implementationClass="org.jetbrains.hexana.wit.WitGoToRelatedSymbolsProvider"/>
        <completion.contributor language="wit" implementationClass="org.jetbrains.hexana.wit.WitKeywordCompletionContributor" />
        <completion.contributor language="wit" implementationClass="org.jetbrains.hexana.wit.WitGateCompletionContributor" />

        <localInspection language="wit"
                         groupBundle="messages.HexanaBundle"
                         groupKey="wit.language.description"
                         bundle="messages.HexanaBundle"
                         key="wit.inspection.empty.definition.display.name"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.jetbrains.hexana.wit.inspections.WitEmptyDefinitionInspection"/>

        <localInspection language="wit"
                         groupBundle="messages.HexanaBundle"
                         groupKey="wit.language.description"
                         bundle="messages.HexanaBundle"
                         key="wit.inspection.world.duplicate.name.display.name"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.jetbrains.hexana.wit.inspections.WitWorldNameUniquenessInspection"/>

        <localInspection language="wit"
                         groupBundle="messages.HexanaBundle"
                         groupKey="wit.language.description"
                         bundle="messages.HexanaBundle"
                         key="wit.inspection.missing.semicolon.display.name"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="org.jetbrains.hexana.wit.inspections.WitMissingSemicolonInspection"/>

        <localInspection language="wit"
                         groupBundle="messages.HexanaBundle"
                         groupKey="wit.language.description"
                         bundle="messages.HexanaBundle"
                         key="wit.inspection.gate.display.name"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.jetbrains.hexana.wit.inspections.WitGateInspection"/>

        <localInspection language="wit"
                         groupBundle="messages.HexanaBundle"
                         groupKey="wit.language.description"
                         bundle="messages.HexanaBundle"
                         key="wit.inspection.use.declaration.missing.names.display.name"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="org.jetbrains.hexana.wit.inspections.WitUseDeclarationInspection"/>

        <langCodeStyleSettingsProvider implementation="org.jetbrains.hexana.wit.formatter.WitLanguageCodeStyleSettingsProvider"/>
        <codeStyleSettingsProvider implementation="org.jetbrains.hexana.wit.formatter.WitCodeStyleSettingsProvider"/>
        <lang.formatter language="wit" implementationClass="org.jetbrains.hexana.wit.formatter.WitFormattingBuilderModel"/>
        <lang.lineWrapStrategy language="wit" implementationClass="org.jetbrains.hexana.wit.formatter.WitLineWrapPositionStrategy"/>

        <configurationType implementation="org.jetbrains.hexana.run.WasmRunConfigurationType"/>
        <runConfigurationProducer implementation="org.jetbrains.hexana.run.WasmRunConfigurationProducer"/>
        <programRunner implementation="org.jetbrains.hexana.run.WasmDebugRunner"/>
        <programRunner implementation="org.jetbrains.hexana.run.CdpDebugRunner"/>
        <xdebugger.breakpointType implementation="org.jetbrains.hexana.run.WasmLineBreakpointType"/>

        <!--
            Optional "JIT Viewer" tab on every Java-based run configuration.
            When enabled, appends -agentpath:<libjitview> so the agent
            records JIT-compiled methods into mem.userDump in the run's
            working directory.
        -->
        <runConfigurationExtension implementation="org.jetbrains.hexana.jit.JitviewRunConfigurationExtension"/>

    </extensions>

    <actions>
        <action id="hexana.openInHexView" class="org.jetbrains.hexana.actions.OpenInHexViewAction">
            <add-to-group group-id="RevealGroup" anchor="last"/>
        </action>
        <action id="hexana.goToOffset" class="org.jetbrains.hexana.actions.GoToOffsetAction"
                use-shortcut-of="GotoLine"/>
        <action id="hexana.showElementInHexView" class="org.jetbrains.hexana.actions.ShowElementInHexViewAction">
            <add-to-group group-id="RevealGroup" anchor="first"/>
        </action>

        <action id="hexana.showStructurePopup" class="org.jetbrains.hexana.actions.ShowStructurePopupAction"
                use-shortcut-of="FileStructurePopup"/>

        <!--
            "Open in... | Hexana" for archives (.jar / .zip / .war / .apk).
            The submenu is only visible when the selected project-view file
            is a Hexana-known archive; the action inside opens it through
            FileEditorManager so HexanaFileEditorProvider claims the file
            via PLACE_BEFORE_DEFAULT_EDITOR.
        -->
        <group id="hexana.openInGroup"
               class="org.jetbrains.hexana.actions.HexanaOpenInGroup">
            <action id="hexana.openArchiveInHexana"
                    class="org.jetbrains.hexana.actions.OpenArchiveInHexanaAction"
                    text="Hexana"
                    description="Open this archive in Hexana's Java library viewer"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </group>

        <!-- "Compare WASM With…" — size-impact diff of two .wasm modules. -->
        <action id="hexana.compareWasm"
                class="org.jetbrains.hexana.actions.CompareWasmAction"
                text="Compare WASM With…"
                description="Compare two .wasm modules by size impact">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="hexana.openInGroup"/>
            <add-to-group group-id="RevealGroup" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
