        <!-- BEGIN firmware LANE-DEBUG -->
        <programRunner implementation="org.jetbrains.hexana.firmware.debug.FirmwareDebugRunner"/>
        <!-- END firmware LANE-DEBUG -->

        <configurationType implementation="org.jetbrains.hexana.run.WasmRunConfigurationType"/>
        <runConfigurationProducer implementation="org.jetbrains.hexana.run.WasmRunConfigurationProducer"/>

        <!-- Hexana Script run configuration -->
        <configurationType implementation="org.jetbrains.hexana.run.HexanaScriptRunConfigurationType"/>
        <runConfigurationProducer implementation="org.jetbrains.hexana.run.HexanaScriptRunConfigurationProducer"/>
        <programRunner implementation="org.jetbrains.hexana.run.WasmDebugRunner"/>
        <programRunner implementation="org.jetbrains.hexana.run.CdpDebugRunner"/>
