        <xdebugger.breakpointType implementation="org.jetbrains.hexana.breakpoints.HexanaBinaryBreakpointType"/>

    </extensions>

    <applicationListeners>
        <!-- Delivers queued PostHog events before the IDE exits. PostHog's own
             close() does not flush, and with flushAt=20 a normal session never
             reaches the batch threshold, so without this the events from the
             last <=30s of every session are dropped. Bounded to 2s. -->
        <listener class="org.jetbrains.hexana.analytics.HexanaAnalyticsLifecycleListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <actions>
        <!--
            All Hexana actions are gathered under a single "Hexana" submenu, defined inline so
            each has exactly one registration site. Each action gates its own visibility — file
            type for the file actions, an open Hexana editor (HexanaFileEditor.KEY) for the
            editor actions — so only the applicable entries appear and the popup hides entirely
            when none apply. Shortcuts are preserved via use-shortcut-of regardless of placement.

            The group is added to TWO parents on purpose:
              - ProjectViewPopupMenu: top-level "Hexana" submenu in IntelliJ IDEA.
              - RevealGroup ("Open In"): the only path that works in RustRover / CLion, whose
                RsProjectViewPopupMenu overrides ProjectViewPopupMenu with an explicit
                reference list (no catch-all), so direct ProjectViewPopupMenu contributions are
                dropped there. Those IDEs DO reference RevealGroup, so "Open In ▸ Hexana" shows.
            Consequence: in IntelliJ IDEA the submenu appears in both places (top-level and
            under "Open In"); that duplication is the accepted trade-off for RR/CLion coverage.
        -->
        <group id="hexana.contextMenuGroup" text="Hexana" popup="true">
            <action id="hexana.openInHexView" class="org.jetbrains.hexana.actions.OpenInHexViewAction"/>
            <action id="hexana.openArchiveInHexana"
                    class="org.jetbrains.hexana.actions.OpenArchiveInHexanaAction"
                    text="Open Archive"
                    description="Open this archive in Hexana's Java library viewer"/>
            <action id="hexana.compareFiles"
                    class="org.jetbrains.hexana.actions.CompareFilesAction"
                    text="Compare Binaries With…"
                    description="Compare two WASM modules, components or native binaries"/>
            <action id="hexana.openAsProtobufMessage"
                    class="org.jetbrains.hexana.actions.OpenAsProtobufMessageAction"
                    text="Open As Protobuf Message"
                    description="Decode this file as a raw Protobuf wire-encoded message"/>
            <!-- hexana.runSuitesForBinary is registered by the org.jetbrains.hexana.suiteRunner
                 content module (absent on 2025.2/2025.3, see <content> below). -->
            <separator/>
            <action id="hexana.showElementInHexView" class="org.jetbrains.hexana.actions.ShowElementInHexViewAction"/>
            <action id="hexana.goToOffset" class="org.jetbrains.hexana.actions.GoToOffsetAction"
                    use-shortcut-of="GotoLine"/>
            <action id="hexana.showStructurePopup" class="org.jetbrains.hexana.actions.ShowStructurePopupAction"
                    use-shortcut-of="FileStructurePopup"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="RevealGroup" anchor="last"/>
        </group>
        <!-- Former compare action ids, before one action served every format. Kept (in no menu,
             hidden from Find Action) so shortcuts bound to them keep working. -->
        <action id="hexana.compareWasm"
                class="org.jetbrains.hexana.actions.LegacyCompareFilesAction"
                text="Compare Binaries With… (former Compare WASM)"/>
        <action id="hexana.compareBinary"
                class="org.jetbrains.hexana.actions.LegacyCompareFilesAction"
                text="Compare Binaries With… (former Compare Binary)"/>

        <action id="hexana.showWhatsNew"
                class="org.jetbrains.hexana.whatsnew.HexanaWhatsNewAction">
            <add-to-group group-id="HelpMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
