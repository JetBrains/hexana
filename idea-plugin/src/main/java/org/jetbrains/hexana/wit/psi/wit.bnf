{
    parserClass = 'org.jetbrains.hexana.wit.psi.WitParser'
    parserUtilClass = 'org.jetbrains.hexana.wit.psi.WitParserUtil'
    psiPackage = 'org.jetbrains.hexana.wit.psi'
    psiImplPackage = 'org.jetbrains.hexana.wit.psi.impl'

    elementTypeHolderClass = 'org.jetbrains.hexana.wit.psi.WitElementTypes'
    elementTypeClass = 'org.jetbrains.hexana.wit.psi.WitElementType'
    psiClassPrefix = 'Wit'
    psiVisitorName = 'WitElementVisitor'

    psiImplUtilClass = 'org.jetbrains.hexana.wit.psi.impl.WitPsiImplUtil'
    tokenTypeClass = 'org.jetbrains.hexana.wit.psi.WitToken'

  //implements("value") = "org.jetbrains.hexana.wit.psi.WitElement"
  //extends("value") = "org.jetbrains.hexana.wit.psi.impl.WitElementImpl"

  tokens = [
    SLASH='/'
    DOT='.'
    COMMA=','
    COLON=':'
    SEMI=';'
    LESS_THAN='<'
    GREATER_THAN='>'
    OPEN_BRACE='{'
    CLOSE_BRACE='}'
    OPEN_PAREN='('
    CLOSE_PAREN=')'
    EQUALS='='
    AT='@'
    UNDERSCORE='_'
    LINE_COMMENT='regexp://.*'
    BLOCK_COMMENT='regexp:/\*([^*]|\*+[^*/])*(\*+/)?'
    ARROW='->'
    NUMBER='regexp:-?(0|[1-9](\d|_)*)'

    // keywords
    ASYNC = "async"
    BLOB = "blob"
    BORROW = "borrow"
    CONSTRUCTOR = "constructor"
    ENUM = "enum"
    EXPORT = "export"
    FLAGS = "flags"
    FUNC = "func"
    FUTURE = "future"
    IMPORT = "import"
    INCLUDE = "include"
    INTERFACE = "interface"
    LIST = "list"
    OPTION = "option"
    PACKAGE = "package"
    RECORD = "record"
    RESOURCE = "resource"
    RESTRICTED = "restricted"
    RESULT = "result"
    STATIC = "static"
    STREAM = "stream"
    TUPLE = "tuple"
    TYPE = "type"
    USE = "use"
    VARIANT = "variant"
    WORLD = "world"
    
    IDENTIFIER="regexp:(%?)[[:jletterdigit:]_][[:jletterdigit:]_-]*"
  ]
}

wit ::= (package-definition)? (package-items | nested-package-definition)*

semver ::= NUMBER !<<white_space>> DOT !<<white_space>> NUMBER
     DOT !<<white_space>> NUMBER
     ('-' (NUMBER | IDENTIFIER)+ (DOT (NUMBER | IDENTIFIER)*)*)?
     ('+' (NUMBER | IDENTIFIER)+ (DOT (NUMBER | IDENTIFIER)*)*)?

package-definition ::= package-decl ';' { pin = 2 }

nested-package-definition ::= package-decl '{' package-items* '}' { pin = 2 }

private package-items ::= toplevel-use-item | interface-item | world-item

gate ::= gate-item*
private gate-item ::= unstable-gate
            | since-gate
            | deprecated-gate

unstable-gate ::= '@unstable' '(' feature-field ')'
since-gate ::= '@since' '(' version-field ')'
deprecated-gate ::= '@deprecated' '(' version-field ')'

feature-field ::= 'feature' '=' IDENTIFIER
version-field ::= 'version' '=' semver

package-name ::= (IDENTIFIER !<<white_space>> ':' !<<white_space>>)+ IDENTIFIER ( !<<white_space>> '/' !<<white_space>> IDENTIFIER )* (!<<white_space>> '@' !<<white_space>> semver)? {
 pin=2
}

private package-decl ::= PACKAGE package-name

toplevel-use-item ::= USE use-path ('as' IDENTIFIER)? ';'

use-path ::= ( IDENTIFIER !<<white_space>> ':' !<<white_space>> )+ IDENTIFIER ( !<<white_space>> '/' !<<white_space>> IDENTIFIER )+ (!<<white_space>> '@' !<<white_space>> semver)?
 | IDENTIFIER

world-item ::= gate WORLD IDENTIFIER '{' world-items* '}'

private world-items ::= gate world-definition

private world-definition ::= export-item
                   | import-item
                   | use-item
                   | typedef-item
                   | include-item

export-item ::= EXPORT IDENTIFIER ':' extern-type
              | EXPORT use-path ';'
import-item ::= IMPORT IDENTIFIER ':' extern-type
              | IMPORT use-path ';'

extern-type ::= func-type ';' | INTERFACE '{' interface-items* '}'

include-item ::= INCLUDE use-path ';'
               | INCLUDE use-path 'with' '{' include-names-list '}'

include-names-list ::= include-names-item (',' include-names-item)*

include-names-item ::= IDENTIFIER 'as' IDENTIFIER

interface-item ::= gate INTERFACE IDENTIFIER '{' interface-items* '}'

private interface-items ::= gate interface-definition

private interface-definition ::= typedef-item
                       | use-item
                       | func-item

private typedef-item ::= resource-item
               | variant-items
               | record-item
               | flags-items
               | enum-item
               | type-item

func-item ::= IDENTIFIER ':' func-type ';'

func-type ::= ASYNC? FUNC param-list result-list?

param-list ::= '(' named-type-list? ')'

result-list ::= '->' ty

named-type-list ::= named-type ( ',' named-type )*

named-type ::= IDENTIFIER ':' ty

use-item ::= USE use-path '.' '{' use-names-list '}' ';'

use-names-list ::= use-names-item (',' use-names-item)* ','?

use-names-item ::= IDENTIFIER 'as' IDENTIFIER | IDENTIFIER

type-item ::= TYPE IDENTIFIER '=' ty ';'

record-item ::= RECORD IDENTIFIER '{' record-fields '}'

record-fields ::= record-field (',' record-field)* ','?

record-field ::= IDENTIFIER ':' ty

flags-items ::= FLAGS IDENTIFIER '{' flags-fields '}'

flags-fields ::= IDENTIFIER (',' IDENTIFIER)* ','?

variant-items ::= VARIANT IDENTIFIER '{' variant-cases '}'

variant-cases ::= variant-case (',' variant-case)* ','?

variant-case ::= IDENTIFIER '(' ty ')' | IDENTIFIER

enum-item ::= ENUM IDENTIFIER '{' enum-cases '}'

enum-case ::= IDENTIFIER
enum-cases ::= enum-case (',' enum-case)* ','?

resource-item ::= RESOURCE IDENTIFIER ';'
                | RESOURCE IDENTIFIER '{' resource-method* '}'

resource-method ::= func-item
                  | IDENTIFIER ':' STATIC func-type ';'
                  | CONSTRUCTOR param-list ';'

ty ::= 'u8' | 'u16' | 'u32' | 'u64'
     | 's8' | 's16' | 's32' | 's64'
     | 'f32' | 'f64'
     | 'char'
     | 'bool'
     | 'string'
     | tuple-definition
     | list-definition
     | option-item
     | result-item
     | handle
     | future-item
     | stream-item
     | IDENTIFIER

tuple-definition ::= TUPLE '<' tuple-list '>'
tuple-list ::= ty (',' ty)* ','?

list-definition ::= LIST '<' ty '>'
       | LIST '<' ty ',' uint '>'

uint ::= NUMBER

option-item ::= OPTION '<' ty '>'

result-item ::= RESULT '<' ty ',' ty '>'
         | RESULT '<' '_' ',' ty '>'
         | RESULT '<' ty '>'
         | RESULT

future-item ::= FUTURE '<' ty '>' | FUTURE

stream-item ::= STREAM '<' ty '>' | STREAM

handle ::= IDENTIFIER | BORROW '<' IDENTIFIER '>'