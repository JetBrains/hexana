{
    parserClass = 'org.jetbrains.hexana.wit.psi.WitParser'
    parserUtilClass = 'org.jetbrains.hexana.wit.psi.WitParserUtil'
    psiPackage = 'org.jetbrains.hexana.wit.psi'
    psiImplPackage = 'org.jetbrains.hexana.wit.psi.impl'

    elementTypeHolderClass = 'org.jetbrains.hexana.wit.psi.WitElementTypes'
    elementTypeClass = 'org.jetbrains.hexana.wit.psi.WitElementType'
    psiClassPrefix = 'Wit'
    psiVisitorName = 'WitElementVisitor'

    psiImplUtilClass = 'org.jetbrains.hexana.wit.psi.impl.WitPsiImplUtil'
    tokenTypeClass = 'org.jetbrains.hexana.wit.psi.WitToken'

  //implements("value") = "org.jetbrains.hexana.wit.psi.WitElement"
  //extends("value") = "org.jetbrains.hexana.wit.psi.impl.WitElementImpl"

  tokens = [
    SLASH='/'
    DOT='.'
    COMMA=','
    COLON=':'
    SEMI=';'
    LESS_THAN='<'
    GREATER_THAN='>'
    OPEN_BRACE='{'
    CLOSE_BRACE='}'
    OPEN_PAREN='('
    CLOSE_PAREN=')'
    EQUALS='='
    AT='@'
    UNDERSCORE='_'
    LINE_COMMENT='regexp://.*'
    BLOCK_COMMENT='regexp:/\*([^*]|\*+[^*/])*(\*+/)?'
    ARROW='->'
    NUMBER='regexp:-?(0|[1-9](\d|_)*)'

    // keywords
    ASYNC = "async"
    BLOB = "blob"
    BORROW = "borrow"
    CONSTRUCTOR = "constructor"
    ENUM = "enum"
    EXPORT = "export"
    FLAGS = "flags"
    FUNC = "func"
    FUTURE = "future"
    IMPORT = "import"
    INCLUDE = "include"
    INTERFACE = "interface"
    LIST = "list"
    OPTION = "option"
    PACKAGE = "package"
    RECORD = "record"
    RESOURCE = "resource"
    RESTRICTED = "restricted"
    RESULT = "result"
    STATIC = "static"
    STREAM = "stream"
    TUPLE = "tuple"
    TYPE = "type"
    USE = "use"
    VARIANT = "variant"
    WORLD = "world"
    
    IDENTIFIER="regexp:(%?)[[:jletterdigit:]_][[:jletterdigit:]_-]*"
  ]

  extends("resource-definition|variant-definition|record-definition|flags-definition|enum-definition|type-definition")=type-declaration
  extends("unstable-gate|since-gate|deprecated-gate")=gate-item
  extends("toplevel-use-declaration|interface-definition|world-definition")=package-item
}

wit ::= (package-definition)? (package-item | nested-package-definition)*

semver ::= NUMBER !<<white_space>> DOT !<<white_space>> NUMBER
     DOT !<<white_space>> NUMBER
     ('-' (NUMBER | IDENTIFIER)+ (DOT (NUMBER | IDENTIFIER)*)*)?
     ('+' (NUMBER | IDENTIFIER)+ (DOT (NUMBER | IDENTIFIER)*)*)?

package-definition ::= package-decl ';' { pin = 2 }

nested-package-definition ::= package-decl '{' package-item* '}' { pin = 2 }

package-item ::= toplevel-use-declaration | interface-definition | world-definition  {
    methods=[
        getName
        getNameIdentifier
        setName
        getTextOffset
    ]
    implements=["com.intellij.psi.NavigatablePsiElement"; "com.intellij.psi.PsiNamedElement";
    "com.intellij.psi.PsiNameIdentifierOwner"]
}

private gate ::= gate-item+
gate-item ::= unstable-gate
            | since-gate
            | deprecated-gate

unstable-gate ::= '@unstable' '(' feature-field ')'
since-gate ::= '@since' '(' version-field ')'
deprecated-gate ::= '@deprecated' '(' version-field ')'

feature-field ::= 'feature' '=' IDENTIFIER
version-field ::= 'version' '=' semver

package-name ::= (IDENTIFIER !<<white_space>> ':' !<<white_space>>)+ IDENTIFIER ( !<<white_space>> '/' !<<white_space>> IDENTIFIER )* (!<<white_space>> '@' !<<white_space>> semver)? {
 pin=2
}

private package-decl ::= PACKAGE package-name

toplevel-use-declaration ::= USE use-path ('as' IDENTIFIER)? ';'

use-path ::= ( IDENTIFIER !<<white_space>> ':' !<<white_space>> )+ IDENTIFIER ( !<<white_space>> '/' !<<white_space>> IDENTIFIER )+ (!<<white_space>> '@' !<<white_space>> semver)?
 | IDENTIFIER  {
  mixin = "org.jetbrains.hexana.wit.psi.WitUsePathMixin"
  methods=[
    getIdentifier
  ]
}

world-definition ::= gate? WORLD IDENTIFIER '{' world-items* '}'

private world-items ::= gate? world-item-definition

private world-item-definition ::= export-definition
                   | import-definition
                   | use-declaration
                   | type-declaration
                   | include-declaration

export-definition ::= EXPORT IDENTIFIER ':' extern-type
              | EXPORT use-path ';'
import-definition ::= IMPORT IDENTIFIER ':' extern-type
              | IMPORT use-path ';'

extern-type ::= func-type ';' | INTERFACE '{' interface-items* '}'

include-declaration ::= INCLUDE use-path ';'
               | INCLUDE use-path 'with' '{' include-names-list '}'

include-names-list ::= include-names-item (',' include-names-item)*

include-names-item ::= IDENTIFIER 'as' IDENTIFIER {
    mixin="org.jetbrains.hexana.wit.psi.WitIncludeNamesItemMixin"
}

interface-definition ::= gate? INTERFACE IDENTIFIER '{' interface-items* '}'

private interface-items ::= gate? interface-item-definition

private interface-item-definition ::= type-declaration
                       | use-declaration
                       | func-item

type-declaration ::= resource-definition
               | variant-definition
               | record-definition
               | flags-definition
               | enum-definition
               | type-definition {
                    methods=[
                        getName
                        getNameIdentifier
                        setName
                        getTextOffset
                    ]
                    implements=["com.intellij.psi.NavigatablePsiElement"; "com.intellij.psi.PsiNamedElement";
                    "com.intellij.psi.PsiNameIdentifierOwner"]
               }

func-item ::= IDENTIFIER ':' func-type ';'

func-type ::= ASYNC? FUNC param-list result-list?

param-list ::= '(' named-type-list? ')'

result-list ::= '->' type-usage

named-type-list ::= named-type ( ',' named-type )*

named-type ::= IDENTIFIER ':' type-usage

use-declaration ::= USE use-path '.' '{' use-names-list '}' ';'

use-names-list ::= use-names-item (',' use-names-item)* ','?

use-names-item ::= IDENTIFIER 'as' IDENTIFIER | IDENTIFIER {
    mixin="org.jetbrains.hexana.wit.psi.WitUseNamesItemMixin"
}

type-definition ::= TYPE IDENTIFIER '=' type-usage ';'

record-definition ::= RECORD IDENTIFIER '{' record-fields '}'

private record-fields ::= record-field (',' record-field)* ','?

record-field ::= IDENTIFIER ':' type-usage

flags-definition ::= FLAGS IDENTIFIER '{' flags-fields '}'

private flags-fields ::= IDENTIFIER (',' IDENTIFIER)* ','?

variant-definition ::= VARIANT IDENTIFIER '{' variant-cases '}'

private variant-cases ::= variant-case (',' variant-case)* ','?

variant-case ::= IDENTIFIER '(' type-usage ')' | IDENTIFIER

enum-definition ::= ENUM IDENTIFIER '{' enum-cases '}'

enum-case ::= IDENTIFIER
private enum-cases ::= enum-case (',' enum-case)* ','?

resource-definition ::= RESOURCE IDENTIFIER ';'
                | RESOURCE IDENTIFIER '{' resource-method* '}'

resource-method ::= func-item
                  | IDENTIFIER ':' STATIC func-type ';'
                  | CONSTRUCTOR param-list ';'

type-usage ::= 'u8' | 'u16' | 'u32' | 'u64'
     | 's8' | 's16' | 's32' | 's64'
     | 'f32' | 'f64'
     | 'char'
     | 'bool'
     | 'string'
     | tuple-definition
     | list-definition
     | option-item
     | result-item
     | handle
     | future-item
     | stream-item
     | IDENTIFIER

tuple-definition ::= TUPLE '<' tuple-list '>'
tuple-list ::= type-usage (',' type-usage)* ','?

list-definition ::= LIST '<' type-usage '>'
       | LIST '<' type-usage ',' uint '>'

uint ::= NUMBER

option-item ::= OPTION '<' type-usage '>'

result-item ::= RESULT '<' type-usage ',' type-usage '>'
         | RESULT '<' '_' ',' type-usage '>'
         | RESULT '<' type-usage '>'
         | RESULT

future-item ::= FUTURE '<' type-usage '>' | FUTURE

stream-item ::= STREAM '<' type-usage '>' | STREAM

handle ::= IDENTIFIER | BORROW '<' IDENTIFIER '>' {
    mixin = "org.jetbrains.hexana.wit.psi.WitHandleMixin"
}