		/* node '/soc/uart@40005000' defined in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:80 */
		uart1: uart@40005000 {
			compatible = "arm,cmsdk-uart";  /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:81 */
			reg = < 0x40005000 0x1000 >;    /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:82 */
			interrupts = < 0x2 0x3 >;       /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:83 */
			clocks = < &sysclk &syscon >;   /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:84 */
			current-speed = < 0x1c200 >;    /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:85 */
			pinctrl-0 = < &uart1_default >; /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:86 */
			pinctrl-names = "default";      /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:87 */
