			reg = < 0x40001000 0x1000 >;    /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:58 */
			interrupts = < 0x9 0x3 >;       /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:59 */
			clocks = < &syscon >;           /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:60 */
		};

