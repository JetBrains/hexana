		gpio2: gpio@40012000 {
			compatible = "arm,cmsdk-gpio"; /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:115 */
			reg = < 0x40012000 0x1000 >;   /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:116 */
			interrupts = < 0x2a 0x3 >;     /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:117 */
			gpio-controller;               /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:118 */
			#gpio-cells = < 0x2 >;         /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:119 */
