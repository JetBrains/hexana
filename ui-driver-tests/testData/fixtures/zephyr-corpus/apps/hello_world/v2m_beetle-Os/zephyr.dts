			reg = < 0x40010000 0x1000 >;   /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:98 */
			interrupts = < 0x6 0x3 >;      /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:99 */
			gpio-controller;               /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:100 */
			#gpio-cells = < 0x2 >;         /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:101 */
