			interrupts = < 0xa 0x3 >;        /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:66 */
			clocks = < &syscon >;            /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:67 */
