			reg = < 0x40011000 0x1000 >;   /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:107 */
			interrupts = < 0x7 0x3 >;      /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:108 */
			gpio-controller;               /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:109 */
			#gpio-cells = < 0x2 >;         /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:110 */
			clocks = < &syscon >;          /* in zephyr/boards/arm/v2m_beetle/v2m_beetle.dts:111 */
		};

