<Project Sdk="Microsoft.NET.Sdk">
  <!-- Converts a PE assembly to Webcil with the .NET SDK's own converter (the one Blazor publish runs). -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings></PropertyGroup>
  <PropertyGroup><WebAssemblySdkPack Condition="'$(WebAssemblySdkPack)' == ''">$(NuGetPackageRoot)microsoft.net.sdk.webassembly.pack/10.0.14</WebAssemblySdkPack></PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.NET.WebAssembly.Webcil"><HintPath>$(WebAssemblySdkPack)/tools/net10.0/Microsoft.NET.WebAssembly.Webcil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
