(module
  (func (export "f") (param i32) (result i32)
    (block $outer (result i32)
      (loop $inner (result i32)
        (local.get 0)
        (if (result i32) (i32.eqz)
          (then (i32.const 0))
          (else
            (local.get 0)
            (i32.const 1)
            (i32.sub)
            (local.set 0)
            (br $inner)
          )
        )
      )
    )
  )
)